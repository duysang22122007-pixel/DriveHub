Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^assets/images/(.+)$ public/assets/images/$1 [L]
    RewriteRule ^(app|config|configs|controllers|models|routes|storage|views)(/|$) - [F,L,NC]
    RewriteRule ^assets/uploads/vehicles/([a-f0-9]{32}\.(jpg|png|webp))$ public/assets/uploads/vehicles/$1 [L]
    RewriteRule ^assets/uploads(/|$) - [F,L,NC]
    RewriteRule ^assets/(.+)$ public/assets/$1 [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
